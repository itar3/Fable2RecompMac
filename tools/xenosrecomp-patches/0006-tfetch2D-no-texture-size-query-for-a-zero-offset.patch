From a997221f0384867b277e1caa1e686e2a1c90b22b Mon Sep 17 00:00:00 2001
From: itar3 <62651854+itar3@users.noreply.github.com>
Date: Fri, 13 Nov 2026 15:21:21 +0500
Subject: [PATCH 6/9] tfetch2D: no texture size query for a zero offset

Nearly every 2D fetch passes a constant zero offset, but offset / size
cannot be folded away (0 / 0 is NaN), so each fetch queried the texture
size and divided. The offset is now applied only when it is not zero.
---
 XenosRecomp/shader_common.h | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/XenosRecomp/shader_common.h b/XenosRecomp/shader_common.h
index 3bfb270..b6797aa 100644
--- a/XenosRecomp/shader_common.h
+++ b/XenosRecomp/shader_common.h
@@ -180,7 +180,11 @@ float4 tfetch1D(uint resourceDescriptorIndex, uint samplerDescriptorIndex, float
 float4 tfetch2D(uint resourceDescriptorIndex, uint samplerDescriptorIndex, float2 texCoord, float2 offset)
 {
     Texture2D<float4> texture = g_Texture2DDescriptorHeap[resourceDescriptorIndex];
-    return texture.Sample(g_SamplerDescriptorHeap[samplerDescriptorIndex], texCoord + offset / getTexture2DDimensions(texture));
+    // Nearly every call passes a constant zero offset; the size query and
+    // division (0 / size cannot be folded) cost a texture query per fetch.
+    if (any(offset != 0.0))
+        texCoord += offset / getTexture2DDimensions(texture);
+    return texture.Sample(g_SamplerDescriptorHeap[samplerDescriptorIndex], texCoord);
 }
 
 float2 getWeights2D(uint resourceDescriptorIndex, uint samplerDescriptorIndex, float2 texCoord, float2 offset)
