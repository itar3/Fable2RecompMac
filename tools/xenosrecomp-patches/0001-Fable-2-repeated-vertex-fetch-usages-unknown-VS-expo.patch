+        uint32_t usageKey = 0xFFu;
+        auto ve = vertexElements.find(address);
+        if (ve != vertexElements.end())
+            usageKey = uint32_t(ve->second.usage) | (uint32_t(ve->second.usageIndex) << 4);
+        VertexFetchLayoutRecord rec;
+        rec.w0 = 0x400u | (site << 16) | (usageKey & 0xFFu);
+        rec.w1 = (address & 0xFFFFu) | ((parent & 0xFFFFu) << 16);
+        vertexLayout.push_back(rec);
+    }
+
+    if (!instr.isMiniFetch)
+    {
+        const uint32_t w0 = 0x200u | (slot << 16);
+        bool seen = false;
+        for (const VertexFetchLayoutRecord& r : vertexLayout)
+            seen |= r.w0 == w0;
+        if (!seen)
+            vertexLayout.push_back({ w0, 0 });
+
+        indent();
+        if (site != 0xFFu)
+            println("vpElement = vfetchPullElement(r{}.{}, {}, vfetchSiteStride({}u, {}u));", instr.srcRegister,
+                SWIZZLES[instr.srcSwizzle], instr.isIndexRounded ? "true" : "false", site, instr.stride);
+        else
+            println("vpElement = vfetchPullElement(r{}.{}, {}, {}u);", instr.srcRegister,
+                SWIZZLES[instr.srcSwizzle], instr.isIndexRounded ? "true" : "false", instr.stride);
+    }
