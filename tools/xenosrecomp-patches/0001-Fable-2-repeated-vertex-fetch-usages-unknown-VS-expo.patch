+    indent();
+    print("r{}.", instr.dstRegister);
+    printDstSwizzle(instr.dstSwizzle, false);
+    if (site != 0xFFu)
+        print(" = vfetchPull(vfetchSiteSlot({0}u, {1}u), vpElement + vfetchSiteOffset({0}u, {2}), vfetchSiteFormat({0}u, {3}u), "
+              "vfetchSiteFlags({0}u, {4}u), vfetchSiteScale({0}u, asfloat(0x{5:X}u))).",
+            site, slot, int32_t(instr.offset), uint32_t(instr.format), flags, scaleBits);
+    else
+        print(" = vfetchPull({}u, vpElement + ({}), {}u, {}u, asfloat(0x{:X}u)).", slot, int32_t(instr.offset),
+            uint32_t(instr.format), flags, scaleBits);
+    printDstSwizzle(instr.dstSwizzle, true);
+    out += ";\n";
+
+    printDstSwizzle01(instr.dstRegister, instr.dstSwizzle);
