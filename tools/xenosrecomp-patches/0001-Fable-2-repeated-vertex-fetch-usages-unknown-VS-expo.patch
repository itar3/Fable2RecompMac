+uint vfetchSiteStride(uint site, uint baked) { uint4 e = vfetchSite(site); return (e.x & 0x80000000u) != 0 ? e.y : baked; }
+int vfetchSiteOffset(uint site, int baked) { uint4 e = vfetchSite(site); return (e.x & 0x80000000u) != 0 ? int(e.z) : baked; }
+uint vfetchSiteFormat(uint site, uint baked) { uint4 e = vfetchSite(site); return (e.x & 0x80000000u) != 0 ? (e.w & 0xFFu) : baked; }
+uint vfetchSiteFlags(uint site, uint baked) { uint4 e = vfetchSite(site); return (e.x & 0x80000000u) != 0 ? ((e.w >> 8) & 0xFFu) : baked; }
+float vfetchSiteScale(uint site, float baked)
+{
+    uint4 e = vfetchSite(site);
+    return (e.x & 0x80000000u) != 0 ? ldexp(1.0, float(int(e.w << 8) >> 24)) : baked;
+}
+
+int vfetchPullElement(float index, bool rounded, uint strideDwords)
+{
+    if (strideDwords == 0)
+        return 0;
+    return int(floor(rounded ? index + 0.5 : index)) * int(strideDwords);
+}
+
+uint vfetchPullEndian(uint slot)
+{
+    uint64_t table = g_VertexPullTable;
+    // Bit 4: the host already swapped the words (the endian mode stays for the
+    // 16-bit half order below).
+    return table == 0 ? 0u : (vk::RawBufferLoad<uint2>(table + uint64_t(slot) * 16 + 8).y & 0xFu);
+}
+
+// A word's two 16-bit values, the one first in memory as x: after an 8-in-32
+// swap it is the high half (as the host input path's swapped 16-bit inputs),
+// after an 8-in-16 swap the low half.
+uint2 vfetchPullHalves(uint w, uint slot)
+{
+    const bool highFirst = (g_PullFlags & 1u) != 0 && vfetchPullEndian(slot) == 2;
+    return highFirst ? uint2(w >> 16, w & 0xFFFF) : uint2(w & 0xFFFF, w >> 16);
+}
+
+uint vfetchPullWord(uint slot, int dword)
+{
+    uint64_t table = g_VertexPullTable;
+    if (table == 0)
+        return 0;
+    uint64_t entry = table + uint64_t(slot) * 16;
+    uint64_t base = vk::RawBufferLoad<uint64_t>(entry);
+    uint2 info = vk::RawBufferLoad<uint2>(entry + 8);
+    if (base == 0 || dword < 0 || uint(dword) >= info.x)
+        return 0;
+    uint v = vk::RawBufferLoad<uint>(base + uint64_t(dword) * 4);
+    // Xenos endian modes: 1 8-in-16, 2 8-in-32, 3 16-in-32. Bit 4: already
+    // swapped by the host when it copied the buffer.
+    if (info.y == 1 || info.y == 2)
+        v = ((v & 0x00FF00FFu) << 8) | ((v >> 8) & 0x00FF00FFu);
+    if (info.y == 2 || info.y == 3)
+        v = (v << 16) | (v >> 16);
+    return v;
+}
+
+float vfetchPullPacked(uint raw, uint width, uint flags)
+{
+    // flags: 1 signed, 2 integer (unnormalized), 4 signed repeating fraction mode "no zero".
+    const bool isSigned = (flags & 1) != 0, isInteger = (flags & 2) != 0, noZero = (flags & 4) != 0;
+    const float range = float((1u << width) - 1u);
+    if (isSigned)
+    {
+        float v = float(int(raw << (32 - width)) >> (32 - width));
+        if (isInteger)
+            return v;
+        if (noZero)
+            return v * (2.0 / range) + 1.0 / range;
+        if (width <= 2)
+            return max(v, -1.0);
+        return max(v / float((1u << (width - 1)) - 1u), -1.0);
+    }
+    float v = float(raw);
+    return isInteger || width <= 1 ? v : v / range;
+}
+
+float vfetchPull32(uint raw, uint flags)
+{
+    const bool isSigned = (flags & 1) != 0, isInteger = (flags & 2) != 0, noZero = (flags & 4) != 0;
+    if (isSigned)
+    {
+        float v = float(int(raw));
+        if (isInteger)
+            return v;
+        return noZero ? v * (1.0 / 2147483647.5) + 0.5 / 2147483647.5 : v * (1.0 / 2147483647.0);
+    }
+    return isInteger ? float(raw) : float(raw) * (1.0 / 4294967295.0);
+}
+
+float4 vfetchPull(uint slot, int element, uint format, uint flags, float scale)
+{
+    float4 r = 0.0;
+    uint w0 = vfetchPullWord(slot, element);
+    switch (format)
+    {
+    case 6: // k_8_8_8_8
+        r = float4(vfetchPullPacked(w0 & 0xFF, 8, flags), vfetchPullPacked((w0 >> 8) & 0xFF, 8, flags),
+                   vfetchPullPacked((w0 >> 16) & 0xFF, 8, flags), vfetchPullPacked(w0 >> 24, 8, flags));
+        break;
+    case 7: // k_2_10_10_10
+        r = float4(vfetchPullPacked(w0 & 0x3FF, 10, flags), vfetchPullPacked((w0 >> 10) & 0x3FF, 10, flags),
+                   vfetchPullPacked((w0 >> 20) & 0x3FF, 10, flags), vfetchPullPacked(w0 >> 30, 2, flags));
+        break;
+    case 16: // k_10_11_11
+        r.xyz = float3(vfetchPullPacked(w0 & 0x7FF, 11, flags), vfetchPullPacked((w0 >> 11) & 0x7FF, 11, flags),
+                       vfetchPullPacked(w0 >> 22, 10, flags));
+        break;
+    case 17: // k_11_11_10
+        r.xyz = float3(vfetchPullPacked(w0 & 0x3FF, 10, flags), vfetchPullPacked((w0 >> 10) & 0x7FF, 11, flags),
+                       vfetchPullPacked(w0 >> 21, 11, flags));
+        break;
+    case 25: // k_16_16
+    {
+        uint2 h0 = vfetchPullHalves(w0, slot);
+        r.xy = float2(vfetchPullPacked(h0.x, 16, flags), vfetchPullPacked(h0.y, 16, flags));
+        break;
+    }
+    case 26: // k_16_16_16_16
+    {
+        uint2 h0 = vfetchPullHalves(w0, slot), h1 = vfetchPullHalves(vfetchPullWord(slot, element + 1), slot);
+        r = float4(vfetchPullPacked(h0.x, 16, flags), vfetchPullPacked(h0.y, 16, flags),
+                   vfetchPullPacked(h1.x, 16, flags), vfetchPullPacked(h1.y, 16, flags));
+        break;
+    }
+    case 31: // k_16_16_FLOAT
+        r.xy = f16tof32(vfetchPullHalves(w0, slot));
+        break;
+    case 32: // k_16_16_16_16_FLOAT
+    {
+        uint2 h0 = vfetchPullHalves(w0, slot), h1 = vfetchPullHalves(vfetchPullWord(slot, element + 1), slot);
+        r = f16tof32(uint4(h0, h1));
+        break;
+    }
+    case 33: // k_32
+        r.x = vfetchPull32(w0, flags);
+        break;
+    case 34: // k_32_32
+        r.xy = float2(vfetchPull32(w0, flags), vfetchPull32(vfetchPullWord(slot, element + 1), flags));
+        break;
+    case 35: // k_32_32_32_32
+        r = float4(vfetchPull32(w0, flags), vfetchPull32(vfetchPullWord(slot, element + 1), flags),
+                   vfetchPull32(vfetchPullWord(slot, element + 2), flags),
+                   vfetchPull32(vfetchPullWord(slot, element + 3), flags));
+        break;
+    case 36: // k_32_FLOAT
+        r.x = asfloat(w0);
+        break;
+    case 37: // k_32_32_FLOAT
+        r.xy = asfloat(uint2(w0, vfetchPullWord(slot, element + 1)));
+        break;
+    case 57: // k_32_32_32_FLOAT
+        r.xyz = asfloat(uint3(w0, vfetchPullWord(slot, element + 1), vfetchPullWord(slot, element + 2)));
+        break;
+    case 38: // k_32_32_32_32_FLOAT
+        r = asfloat(uint4(w0, vfetchPullWord(slot, element + 1), vfetchPullWord(slot, element + 2),
+                          vfetchPullWord(slot, element + 3)));
+        break;
+    }
+    return r * scale;
+}
+
