+{
+    const uint32_t slot = instr.constIndex * 3 + instr.constIndexSelect;
+    // Pull sites: D3D binds the vfetch format, stride, offset and fetch
+    // constant into a copy of the microcode per vertex declaration, so a
+    // shader recompiled from unbound microcode has none of them (format 0).
+    // Each pulled fetch reads them per draw from the vertex pull table (entry
+    // 96 + site), which the renderer fills from the live microcode or the
+    // bound declaration; the values below are the fallback.
