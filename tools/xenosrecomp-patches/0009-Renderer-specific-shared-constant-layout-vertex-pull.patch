+// Constant access. By default the renderer passes the addresses of the vertex,
+// pixel and shared constant blocks in push constants and shaders load through
+// them (buffer device address). With XE_CONSTANT_BUFFERS the blocks are uniform
+// buffers in descriptor set XE_CONSTANT_SET (binding 0 vertex, 1 pixel, 2
+// shared): the GPU's constant path (on Metal the constant address space, which
+// the compiler can load once per draw instead of once per pixel).
+#ifdef XE_CONSTANT_BUFFERS
+#ifndef XE_CONSTANT_SET
+#define XE_CONSTANT_SET 5
+#endif
+[[vk::binding(0, XE_CONSTANT_SET)]] cbuffer XeVertexShaderConstantsBlock { float4 g_XeVertexShaderConstants[512]; };
+[[vk::binding(1, XE_CONSTANT_SET)]] cbuffer XePixelShaderConstantsBlock { float4 g_XePixelShaderConstants[512]; };
+[[vk::binding(2, XE_CONSTANT_SET)]] cbuffer XeSharedConstantsBlock { uint4 g_XeSharedConstants[96]; };
+#define XE_CONST_F4(block, off)    g_Xe##block[(off) >> 4]
+#define XE_SHARED_U4(off)          g_XeSharedConstants[(off) >> 4]
+#define XE_SHARED_U32(off)         g_XeSharedConstants[(off) >> 4][((off) >> 2) & 3]
