+#define g_VertexPullTable XE_SHARED_U64(1024)
+
+// Pull sites (entry 96 + site of the vertex pull table): { slot | valid bit
+// 31, stride in dwords, offset in dwords, format | flags << 8 | exp_adjust << 16 },
+// the binding D3D put into the live microcode; unset entries keep the
+// recompiled (unbound) values.
+uint4 vfetchSite(uint site)
+{
+    uint64_t table = g_VertexPullTable;
+    if (table == 0)
+        return uint4(0, 0, 0, 0);
+    return vk::RawBufferLoad<uint4>(table + uint64_t(96 + site) * 16);
