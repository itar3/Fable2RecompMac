+    // Fable 2: this framebuffer's render pass with LOAD_OP_CLEAR for the
+    // attachments in mask (compatible with the framebuffer: only load ops differ).
+    VkRenderPass VulkanFramebuffer::clearPass(uint32_t mask) const {
+        mask &= 63;
+        if (mask == 0) {
+            return renderPass;
+        }
+        if (clearPasses[mask] != VK_NULL_HANDLE) {
+            return clearPasses[mask];
+        }
+
+        std::vector<VkAttachmentDescription> descs = attachmentDescs;
+        for (uint32_t i = 0; i < colorRefs.size() && i < 4; i++) {
+            if (mask & (1u << i)) {
+                descs[colorRefs[i].attachment].loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+            }
+        }
+        if (hasDepth) {
+            VkAttachmentDescription &d = descs[depthRef.attachment];
+            if (mask & 16u) {
+                d.loadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+            }
+            if ((mask & 32u) && depthHasStencil) {
+                d.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_CLEAR;
+            }
+        }
+
+        VkSubpassDescription subpass = {};
+        subpass.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+        subpass.pColorAttachments = !colorRefs.empty() ? colorRefs.data() : nullptr;
+        subpass.colorAttachmentCount = uint32_t(colorRefs.size());
+        subpass.pDepthStencilAttachment = hasDepth ? &depthRef : nullptr;
+
+        VkRenderPassCreateInfo passInfo = {};
+        passInfo.sType = VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO;
+        passInfo.pAttachments = descs.data();
+        passInfo.attachmentCount = uint32_t(descs.size());
+        passInfo.pSubpasses = &subpass;
+        passInfo.subpassCount = 1;
+
+        VkRenderPass pass = VK_NULL_HANDLE;
+        if (vkCreateRenderPass(device->vk, &passInfo, nullptr, &pass) != VK_SUCCESS) {
+            return renderPass;
+        }
+        clearPasses[mask] = pass;
+        return pass;
+    }
